# Copy this file to  .streamlit/secrets.toml  and fill in your real values.
# secrets.toml is listed in .gitignore, so it will NOT be uploaded to GitHub.
# Never put real keys in THIS example file.

OPENROUTER_API_KEY = "paste-your-openrouter-key-here"

# Optional: a GitHub token raises the API limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN = "paste-your-github-token-here"

# Optional: use a different OpenRouter model.
# OPENROUTER_MODEL = "openrouter/free"
